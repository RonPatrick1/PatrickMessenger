<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.patricklamphier.patrickMessenger</string>
	</array>
	<key>com.apple.developer.siri</key>
	<true/>
	<!--
	  Once Apple approves the CarPlay entitlement request, add:
	    <key>com.apple.developer.carplay-communication</key>
	    <true/>
	  Adding it before approval will fail code signing (Xcode validates
	  entitlements against the provisioning profile's approved capabilities).
	-->
</dict>
</plist>
