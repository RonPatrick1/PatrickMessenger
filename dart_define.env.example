# Copy this file to dart_define.env and fill in your own values. Never
# commit the real file or its contents — it is already gitignored.
#
# Build and run with:
#   flutter run -d linux --dart-define-from-file=dart_define.env
#   flutter build linux --debug --dart-define-from-file=dart_define.env
#   flutter build apk --debug --dart-define-from-file=dart_define.env
#   flutter build macos --debug --dart-define-from-file=dart_define.env
#
# GIPHY_API_KEY works the same on every platform; see the "Public GIF
# search" section of README.md for how to get one.
GIPHY_API_KEY=

# Desktop-only local development overrides. Android and iPhone/iPad builds
# always use the public HTTPS homeserver regardless of these two values.
MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
ALLOW_INSECURE_DEVELOPMENT=true
