<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP to loopback only, for the in-app HTTP server that
  serves decrypted video to the local media player. Everything else keeps
  Android's default cleartext-blocked behavior.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
